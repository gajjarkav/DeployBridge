APP_NAME="DeployBridge"
APP_VERSION="1.0.0"
APP_DESCRIPTION="A deployment bridge for seamless application deployment."
DEBUG=False
ENV_TYPE="production"
DOCS_URL="/docs"
REDOC_URL=""
HOST=0.0.0.0
PORT=8000
LOG_LEVEL="INFO"

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=""

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_TOKEN_ENCRYPTION_KEY=""

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10000

# ─── Azure AI Foundry (Primary LLM) ─────────────────────────────────────────
AZURE_AI_ENDPOINT=""
AZURE_AI_DEPLOYMENT=""
AZURE_AI_API_KEY=""
AZURE_AI_TIMEOUT_SECONDS=60.0

# ─── Gemini / Groq (Fallback LLM — OpenAI Compatible) ────────────────────────
GROQ_API_KEY=""
GROQ_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GROQ_MODEL="gemini-2.5-flash-lite"
GROQ_TIMEOUT_SECONDS=60.0

# ─── Cloudinary (PDF Storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── SMTP (Email Delivery) ───────────────────────────────────────────────────
REPORT_DELIVERY_ENABLED="True"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# ─── Render Deployment Note ──────────────────────────────────────────────────
# PYTHON_VERSION is a Render BUILD-level variable.
# Set it in: Render Dashboard → Your Service → Environment → Add Variable
# Key: PYTHON_VERSION   Value: 3.12.7
# (It is already configured in render.yaml in the repo root)